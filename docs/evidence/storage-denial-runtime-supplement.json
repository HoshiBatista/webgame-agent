    "script_source": "// Supplemental trusted fixture observation; exact game HTML/source are untouched.\nimport fs from 'node:fs';import crypto from 'node:crypto';\nimport {chromium} from '/validator/node_modules/playwright/index.mjs';\nimport {installStorageProbe} from '/validator/storage_probe.mjs';\nimport {tapReachable} from '/validator/touch_scroll_probe.mjs';\nconst hash=b=>crypto.createHash('sha256').update(b).digest('hex');\nconst html=fs.readFileSync('/input/game.html','utf8'),config=JSON.parse(fs.readFileSync('/input/config.json','utf8'));\nconst checks=[],observations=[],files=[];const record=(name,passed,evidence)=>checks.push({name,passed,evidence});\nconst save=(name,data)=>{fs.writeFileSync('/evidence/'+name,data);files.push({path:name,bytes:Buffer.byteLength(data),sha256:hash(data)});};\nconst browser=await chromium.launch({headless:true,executablePath:process.env.CHROMIUM_EXECUTABLE||undefined,args:['--no-sandbox','--disable-dev-shm-usage','--disable-background-networking']});\n// Observe the real context functions when the original install invokes its factory.\n// No callback, state, return value or source byte is rewritten. Faults come solely\n// from the separately labelled Storage probe or the browser's opaque origin.\nfunction observeContext(){const define=Object.defineProperty;Object.defineProperty=function(target,name,descriptor){if(target===window&&name==='Prompt2PlayRuntime'){const runtime=descriptor.value;descriptor={...descriptor,value:Object.freeze({version:runtime.version,install(factory,spec){return runtime.install(ctx=>{define(window,'__STORAGE_REVIEW_CONTEXT__',{value:ctx.storage,configurable:true});return factory(ctx);},spec);}})};Object.defineProperty=define;}return define(target,name,descriptor);};}\nfor(const mode of ['denied','quota','opaque'])for(const width of [1280,390]){\n const tag=mode+'-'+width,touch=width===390,context=await browser.newContext({viewport:{width,height:844},isMobile:touch,hasTouch:touch,serviceWorkers:'block',acceptDownloads:false});\n await context.addInitScript(observeContext);if(mode!=='opaque')await context.addInitScript(installStorageProbe);\n await context.tracing.start({screenshots:true,snapshots:true,sources:false});const page=await context.newPage(),errors=[],logs=[],network=[];page.setDefaultTimeout(5000);page.on('pageerror',e=>errors.push(e.message));page.on('console',m=>logs.push({type:m.type(),text:m.text().slice(0,1000)}));\n await context.route('**/*',async route=>{const url=route.request().url();if(url==='http://studio.invalid/')return route.fulfill({contentType:'text/html',body:'<!doctype html><html><head><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head><style>html,body,iframe{margin:0;width:100%;height:100%;border:0}body{height:100vh}</style><iframe sandbox=\"allow-scripts\" referrerpolicy=\"no-referrer\" src=\"http://game.invalid/index.html\"></iframe></html>'});if(url==='http://game.invalid/index.html')return route.fulfill({contentType:'text/html',body:html});network.push(url);return route.abort();});\n try{\n  await page.goto(mode==='opaque'?'http://studio.invalid/':'http://game.invalid/index.html');const frame=mode==='opaque'?page.frames().find(f=>f.url()==='http://game.invalid/index.html'):page.mainFrame();if(!frame)throw new Error('Game frame unavailable');\n  const transport={evaluate:(...args)=>frame.evaluate(...args),locator:(...args)=>frame.locator(...args),viewportSize:()=>page.viewportSize(),touchscreen:page.touchscreen,context:()=>({newCDPSession:()=>context.newCDPSession(page)}),waitForTimeout:ms=>page.waitForTimeout(ms)};\n  const clicks=[];const click=async selector=>{if(touch)clicks.push({selector,swipes:await tapReachable(transport,selector)});else await frame.locator(selector).click();};\n  if(mode!=='opaque')await frame.evaluate(mode=>window.__FORGE_STORAGE_PROBE__.setMode(mode),mode);\n  const origin=await frame.evaluate(()=>{try{return{origin:self.origin,denied:false,key:localStorage.getItem('storage-review-origin')}}catch(e){return{origin:self.origin,denied:true,error:e.name}}});\n  const result=await frame.evaluate(async()=>{const api=window.__STORAGE_REVIEW_CONTEXT__;return{load:await api.load(),save:await api.save({independentProbe:true})}});\n  record('runtime-denial-return:'+tag,result.load===null&&result.save===false,{actual_context_api:true,result,origin,mode,fault_injected:mode!=='opaque'});\n  if(mode==='opaque')record('browser-opaque-denial:'+tag,origin.origin==='null'&&origin.denied&&origin.error==='SecurityError',origin);\n  await click('#p2p-start');const before=await frame.evaluate(()=>window.__GAME_TEST__.snapshot());\n  for(let index=0;index<3;index++){if(touch)await click('#move-'+index);else await page.keyboard.press(String(index+1));}\n  const won=await frame.evaluate(()=>window.__GAME_TEST__.snapshot()),text=await frame.locator('body').innerText();\n  record('ordinary-gameplay-despite-denial:'+tag,before.phase==='playing'&&won.phase==='won'&&won.moves===3&&won.cells.every(Boolean),{actual_input:true,before,won,touch,clicks});\n  record('no-false-save-success-label:'+tag,!/saved|сохран[её]н/i.test(text),{text,scope:'Reviewed fixture has no save-status presentation; it does not claim successful persistence. No denial-notification UI contract is inferred.'});\n  save('completed-'+tag+'.png',await page.screenshot({fullPage:true}));await click('#p2p-restart');const restarted=await frame.evaluate(()=>window.__GAME_TEST__.snapshot());record('ordinary-restart-despite-denial:'+tag,restarted.phase==='playing'&&restarted.moves===0&&restarted.cells.every(v=>v===false),{actual_input:true,restarted});\n  const probe=mode==='opaque'?null:await frame.evaluate(()=>window.__FORGE_STORAGE_PROBE__.snapshot());if(probe)record('real-storage-fault-observed:'+tag,probe.available&&probe.mode===mode&&probe.successful_writes===0&&(mode==='denied'?probe.denied_accesses>=4:probe.blocked_writes>=4&&probe.write_failures>=4),{probe,synthetic_fault:true});\n  observations.push({tag,origin,result,won,restarted,probe});save('restart-'+tag+'.png',await page.screenshot({fullPage:true}));\n }catch(error){record('supplemental-error:'+tag,false,{message:error.message});save('failure-'+tag+'.png',await page.screenshot({fullPage:true}));}\n finally{record('uncaught-errors:'+tag,errors.length===0,{errors});record('offline-network:'+tag,network.length===0,{network});save('console-'+tag+'.json',JSON.stringify({errors,logs}));save('network-'+tag+'.json',JSON.stringify(network));await context.tracing.stop({path:'/evidence/trace-'+tag+'.zip'});const data=fs.readFileSync('/evidence/trace-'+tag+'.zip');files.push({path:'trace-'+tag+'.zip',bytes:data.length,sha256:hash(data)});await context.close();}\n}\nprocess.stdout.write(JSON.stringify({schema_version:1,scope:'One supplemental experiment on unchanged reviewed optional-capabilities fixture; zero model calls, outside final15 qualification count and v4 freshness denominator.',passed:checks.every(c=>c.passed),html_sha256:hash(Buffer.from(html)),script_sha256:hash(fs.readFileSync('/review/challenge.mjs')),validator_image_sha256:config.image,browser_version:browser.version(),runtime:config.runtime,original_fixture_report_sha256:config.original_report_sha256,instrumentation:'Trusted install observer captures original context load/save functions without changing their arguments or results; direct Storage fault probe for denied/quota, actual allow-scripts opaque-origin iframe for browser SecurityError.',limitations:['Existing reviewed fixture, not a fresh successfully generated storage game.','Denied/quota faults are synthetic and labelled; opaque-origin SecurityError is actual browser behavior.','Fixture has no save-status UI; absence of a false saved label does not demonstrate a complete denial-notification UX.','Chromium emulation, not actual contest WebView.'],observations,checks,evidence_files:files}));await browser.close();\n",
