            "effect": "End combat once"
          },
          {
            "from": "wave",
            "to": "lost",
            "trigger": "lives reach zero",
            "effect": "End combat once"
          }
        ]
      }
    ],
    "resources": [
      {
        "name": "raf",
        "owner": "ui.js",
        "acquire": "mount creates one loop",
        "release": "dispose cancels it",
        "stale_work_policy": "Session identity rejects callbacks after disposal"
      }
    ],
    "invariants": [
      {
        "id": "enemy-accounting",
        "statement": "Completed enemies equal kills plus escapes; no escaped enemy can reward a kill",
        "owners": [
          "engine.js"
        ],
        "check_strategy": "Assert total after wave and varied legal-action campaigns"
      },
      {
        "id": "economy",
        "statement": "Gold is integer; 90-gold tower sale returns floor(90*70/100)=63",
        "owners": [
          "engine.js",
          "ui.js"
        ],
        "check_strategy": "Real build and sell scenario"
      }
    ],
    "state_domains": [
      {
