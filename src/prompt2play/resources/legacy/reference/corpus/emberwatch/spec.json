{
  "title": "Emberwatch · recorded compatibility corpus",
  "summary": "Trusted authored reference replay, not live generation",
  "genre": "tower defence",
  "rules": [
    "Build four tower types on 14 fixed pads",
    "Survive 12 waves using towers, upgrades and meteor",
    "Only active enemies may be targeted or reward gold"
  ],
  "state_schema": "{\"phase\": \"string; Current run state; terminal states stop advancing rules\", \"time\": \"number; Accumulated unpaused simulation time\", \"gold\": \"integer; Spendable currency\", \"kills\": \"integer; Enemies killed once, excluding escapes\", \"stats/leaks\": \"integer; Escapes counted once, regardless of life damage\"}",
  "action_schema": "{\"type\": \"start|pause|tick|build|upgrade|sell|target|wave|meteor\"}",
  "event_schema": "{\"type\": \"object\", \"properties\": {\"id\": {\"type\": \"string\"}, \"type\": {\"const\": \"wave-complete\"}, \"value\": {\"type\": \"integer\"}, \"text\": {\"type\": \"string\"}}, \"required\": [\"id\", \"type\", \"value\", \"text\"], \"additionalProperties\": false}",
  "visual_direction": "Procedural Canvas from the recorded source",
  "audio_direction": "Procedural Web Audio; not externally generated assets",
  "controls": [
    "start",
    "pause",
    "restart",
    "build",
    "upgrade",
    "sell",
    "target",
    "wave",
    "meteor"
  ],
  "win_condition": "12 waves accounted and lives positive",
  "lose_condition": "lives reach zero",
  "smoke_actions": [
    "{\"type\": \"start\"}"
  ],
  "affected_files": [
    "engine.js",
    "renderer.js",
    "audio.js",
    "ui.js"
  ],
  "acceptance_criteria": [
    "Complete a real wave and account each enemy exactly once",
    "Paused simulation stays frozen and restart restores initial resources",
    "Build/sell preserves the intended integer currency rule"
  ],
  "semantic_contract": {
    "version": 3,
    "timing": {
      "mode": "fixed_step",
      "step_action": "{\"type\":\"tick\"}",
      "step_seconds": 0.016666666666666666,
      "max_catchup_steps": 12,
      "pause_policy": "Paused state rejects progress; reset creates a fresh run; hidden time is discarded."
    },
    "fields": [
      {
        "id": "phase",
        "path": "/phase",
        "type": "string",
        "unit": "state label",
        "meaning": "Current run state; terminal states stop advancing rules",
        "owner": "engine.js",
        "consumers": [
          "renderer.js",
          "ui.js"
        ],
        "example_json": "\"menu\""
      },
      {
        "id": "time",
        "path": "/time",
        "type": "number",
        "unit": "simulation seconds",
        "meaning": "Accumulated unpaused simulation time",
        "owner": "engine.js",
        "consumers": [
          "renderer.js",
          "ui.js"
        ],
        "example_json": "1.0"
      },
      {
        "id": "gold",
        "path": "/gold",
        "type": "integer",
        "unit": "gold pieces",
        "meaning": "Spendable currency",
        "owner": "engine.js",
        "consumers": [
          "renderer.js",
          "ui.js"
        ],
        "example_json": "260"
      },
      {
        "id": "kills",
        "path": "/kills",
        "type": "integer",
        "unit": "enemies",
        "meaning": "Enemies killed once, excluding escapes",
        "owner": "engine.js",
        "consumers": [
          "renderer.js",
          "ui.js"
        ],
        "example_json": "0"
      },
      {
        "id": "stats-leaks",
        "path": "/stats/leaks",
        "type": "integer",
        "unit": "enemies",
        "meaning": "Escapes counted once, regardless of life damage",
        "owner": "engine.js",
        "consumers": [
          "renderer.js",
          "ui.js"
        ],
        "example_json": "0"
      }
    ],
    "events": [
      {
        "type": "wave-complete",
        "payload_schema": "{\"type\": \"object\", \"properties\": {\"id\": {\"type\": \"string\"}, \"type\": {\"const\": \"wave-complete\"}, \"value\": {\"type\": \"integer\"}, \"text\": {\"type\": \"string\"}}, \"required\": [\"id\", \"type\", \"value\", \"text\"], \"additionalProperties\": false}",
        "example_json": "{\"id\": \"1\", \"type\": \"wave-complete\", \"value\": 1, \"text\": \"Доход за волну: 41\"}",
        "delivery": "Engine drains real event queue after dispatch; IDs identify a run sequence and audio is recreated on reset. wave-complete.value is the wave number, not its gold reward.",
        "owner": "engine.js",
        "consumers": [
          "audio.js",
          "ui.js"
        ]
      }
    ],
    "state_machines": [
      {
        "id": "campaign",
        "owner": "engine.js",
        "states": [
          "menu",
          "build",
          "wave",
          "won",
          "lost"
        ],
        "initial_state": "menu",
        "terminal_states": [
          "won",
          "lost"
        ],
        "transitions": [
          {
            "from": "menu",
            "to": "build",
            "trigger": "start action",
            "effect": "Start the run exactly once"
          },
          {
            "from": "build",
