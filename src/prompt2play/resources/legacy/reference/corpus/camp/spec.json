{
  "title": "Пепельный свод · записанный корпус совместимости",
  "summary": "Complete reviewed camp roguelike2.0.1 adapted for real Forge graph compatibility; not live model generation",
  "genre": "turn-based roguelike with persistent camp",
  "rules": [
    "Explore five procedural floors with three hero classes",
    "NPC quests authorize four permanent buildings",
    "Each new attempt resets hero level and XP; bank and buildings survive",
    "Safe return/victory transfers carried loot once; death/abandonment loses carried loot"
  ],
  "state_schema": "{\"/campaign/mode\": \"Campaign phase; run result is settled before returning to camp\", \"/campaign/meta/resources\": \"Permanent spendable camp bank; distinct from the active hero backpack\", \"/campaign/meta/buildings\": \"Permanent building levels, each gated by an NPC quest\", \"/campaign/meta/quests\": \"Permanent quest status and bounded progress accumulated after acceptance\", \"/campaign/meta/stats\": \"Aggregate statistics committed with settlement\", \"/campaign/engine/state/player\": \"Present only during an attempt/result; level, XP, temporary gear and carried resources reset on the next attempt\", \"/campaign/engine/rng\": \"Present during an attempt; restore preserves future random outcomes\", \"/campaign/engine/state/floor\": \"Present during an attempt; starts at one, ends after fifth-floor boss and exit\", \"/bonuses\": \"Read-only bonuses derived from canonical building levels and applied once when constructing a new hero\", \"/quests\": \"Read-only objective/gate views from the one canonical campaign catalog\", \"/events\": \"Bounded events are presentation only and disappear on restore; quest accounting uses rule counters\", \"/persistence/status\": \"UI reports saved only after a write succeeds; memory and blocked retain the live session\"}",
  "action_schema": "{\"type\": \"start|acceptQuest|claimQuest|upgradeBuilding|choose|return|abandon|pause|move|cast|potion|interact|wait\"}",
  "event_schema": "{\"type\": \"object\", \"properties\": {\"id\": {\"type\": \"string\"}, \"type\": {\"const\": \"step\"}}, \"required\": [\"id\", \"type\"], \"additionalProperties\": true}",
  "visual_direction": "Reviewed original procedural Canvas dungeon and NPC camp scenes; articulated walking and reduced motion",
  "audio_direction": "Reviewed original medieval score and procedural effects with original UI routing",
  "controls": [
    "WASD/arrows",
    "pointer/touch",
    "E interact/depart",
    "R return",
    "J quests",
    "Escape pause"
  ],
  "win_condition": "Defeat the fifth-floor boss, exit and settle victory",
  "lose_condition": "Hero HP reaches zero; permanent camp remains",
  "smoke_actions": [
    "{\"type\":\"start\",\"seed\":\"embers\",\"classId\":\"mage\"}"
  ],
  "affected_files": [
    "engine.js",
    "renderer.js",
    "audio.js",
    "ui.js"
  ],
  "acceptance_criteria": [
    "Accept an NPC quest, earn and deliver loot legally, claim a gate, build a permanent bonus and start a fresh hero",
    "Pausing rejects game turns; abandonment preserves the camp and a new attempt resets hero XP",
    "Actual save/load preserves rules and RNG, then the same legal continuation reaches the identical state",
    "Repeated return, reload and quest claim cannot credit the same loot or reward twice",
    "Empty, malformed and incompatible imports leave the live campaign untouched",
    "Quota and denied storage preserve accepted in-memory actions and expose a truthful unsaved status",
    "Locked upgrades and premature claims do not debit resources or grant bonuses"
  ],
  "semantic_contract": {
    "version": 3,
    "timing": {
      "mode": "turn_based",
      "step_action": "{}",
      "step_seconds": 0,
      "max_catchup_steps": 0,
      "pause_policy": "Only accepted public actions advance turns; menus block movement and hidden time is discarded"
    },
