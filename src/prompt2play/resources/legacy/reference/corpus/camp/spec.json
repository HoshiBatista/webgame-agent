      "id": "camp-pause-reset",
      "category": "lifecycle",
      "purpose": "Pausing rejects game turns; abandonment preserves the camp and a new attempt resets hero XP",
      "seed": "embers",
      "steps": [
        "{\"op\":\"act\",\"action\":{\"type\":\"acceptQuest\",\"id\":\"watch_1\"}}",
        "{\"op\":\"act\",\"action\":{\"type\":\"start\",\"seed\":\"embers\",\"classId\":\"mage\"}}",
        "{\"op\":\"act\",\"action\":{\"type\":\"cast\",\"skill\":\"bolt\",\"x\":20,\"y\":20}}",
        "{\"op\":\"act\",\"action\":{\"type\":\"wait\"},\"repeat\":3}",
        "{\"op\":\"act\",\"action\":{\"type\":\"move\",\"dx\":0,\"dy\":1},\"repeat\":3}",
        "{\"op\":\"act\",\"action\":{\"type\":\"move\",\"dx\":-1,\"dy\":0}}",
        "{\"op\":\"act\",\"action\":{\"type\":\"move\",\"dx\":0,\"dy\":-1}}",
        "{\"op\":\"act\",\"action\":{\"type\":\"move\",\"dx\":1,\"dy\":0},\"repeat\":2}",
        "{\"op\":\"act\",\"action\":{\"type\":\"pause\",\"value\":true}}",
        "{\"op\":\"capture\",\"key\":\"paused\"}",
        "{\"op\":\"act\",\"action\":{\"type\":\"wait\"}}",
        "{\"op\":\"assert\",\"left\":{\"path\":\"/campaign\"},\"cmp\":\"eq\",\"right\":{\"saved\":\"paused\",\"path\":\"/campaign\"}}",
        "{\"op\":\"act\",\"action\":{\"type\":\"pause\",\"value\":false}}",
        "{\"op\":\"act\",\"action\":{\"type\":\"abandon\"}}",
        "{\"op\":\"capture\",\"key\":\"camp\"}",
        "{\"op\":\"act\",\"action\":{\"type\":\"start\",\"seed\":\"next-attempt\",\"classId\":\"mage\"}}",
        "{\"op\":\"assert\",\"left\":{\"path\":\"/campaign/engine/state/player/level\"},\"cmp\":\"eq\",\"right\":{\"value\":1}}",
        "{\"op\":\"assert\",\"left\":{\"path\":\"/campaign/engine/state/player/xp\"},\"cmp\":\"eq\",\"right\":{\"value\":0}}",
