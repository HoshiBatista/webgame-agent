{
  "title": "Прыжок через пропасть · recorded corpus",
  "summary": "Trusted authored reference replay, not live generation",
  "genre": "platformer",
  "rules": [
    "Advance one world unit per fixed step",
    "Jump over pit at units 50 through 65",
    "Reach unit 100 to win"
  ],
  "state_schema": "{\"phase\": \"string; Current run state; terminal states stop advancing rules\", \"distance\": \"number; Distance traversed by accepted simulation steps\", \"y\": \"number; Jump displacement above ground\", \"time\": \"number; Time advances only while playing and unpaused\"}",
  "action_schema": "{\"type\": \"start|pause|tick|jump\"}",
  "event_schema": "{\"type\": \"object\", \"properties\": {\"id\": {\"type\": \"string\"}, \"type\": {\"const\": \"jump\"}}, \"required\": [\"id\", \"type\"], \"additionalProperties\": false}",
  "visual_direction": "Procedural Canvas from the recorded source",
  "audio_direction": "Procedural Web Audio; not externally generated assets",
  "controls": [
    "start",
    "pause",
    "restart",
    "jump"
  ],
  "win_condition": "distance reaches 100",
  "lose_condition": "pit contact without jump height",
  "smoke_actions": [
    "{\"type\": \"jump\"}"
  ],
  "affected_files": [
    "engine.js",
    "renderer.js",
    "audio.js",
    "ui.js"
  ],
  "acceptance_criteria": [
    "jump-to-win",
    "no-jump-loses",
    "pause-reset"
  ],
  "semantic_contract": {
    "version": 3,
    "timing": {
      "mode": "fixed_step",
      "step_action": "{\"type\":\"tick\"}",
      "step_seconds": 0.016666666666666666,
      "max_catchup_steps": 6,
      "pause_policy": "Paused state rejects progress; reset creates a fresh run; hidden time is discarded."
    },
    "fields": [
      {
        "id": "phase",
        "path": "/phase",
        "type": "string",
        "unit": "state label",
        "meaning": "Current run state; terminal states stop advancing rules",
        "owner": "engine.js",
        "consumers": [
          "renderer.js",
          "ui.js"
        ],
        "example_json": "\"menu\""
      },
      {
        "id": "distance",
        "path": "/distance",
        "type": "number",
        "unit": "world units",
        "meaning": "Distance traversed by accepted simulation steps",
        "owner": "engine.js",
        "consumers": [
          "renderer.js",
          "ui.js"
        ],
        "example_json": "0"
      },
      {
        "id": "y",
        "path": "/y",
        "type": "number",
        "unit": "canvas units; down positive",
        "meaning": "Jump displacement above ground",
        "owner": "engine.js",
        "consumers": [
          "renderer.js",
          "ui.js"
        ],
        "example_json": "0"
      },
      {
        "id": "time",
        "path": "/time",
        "type": "number",
        "unit": "simulation seconds",
        "meaning": "Time advances only while playing and unpaused",
        "owner": "engine.js",
        "consumers": [
          "renderer.js",
          "ui.js"
        ],
        "example_json": "0"
      }
    ],
    "events": [
      {
        "type": "jump",
        "payload_schema": "{\"type\": \"object\", \"properties\": {\"id\": {\"type\": \"string\"}, \"type\": {\"const\": \"jump\"}}, \"required\": [\"id\", \"type\"], \"additionalProperties\": false}",
        "example_json": "{\"id\": \"1\", \"type\": \"jump\"}",
        "delivery": "Engine drains real events after dispatch; audio deduplicates IDs and is recreated on reset.",
        "owner": "engine.js",
        "consumers": [
          "audio.js",
          "ui.js"
        ]
      }
    ],
    "state_machines": [
      {
        "id": "run",
        "owner": "engine.js",
        "states": [
          "menu",
          "playing",
          "won",
          "lost"
        ],
        "initial_state": "menu",
        "terminal_states": [
          "won",
          "lost"
        ],
        "transitions": [
          {
            "from": "menu",
            "to": "playing",
            "trigger": "start action",
            "effect": "Start the run exactly once"
          },
          {
            "from": "playing",
            "to": "won",
            "trigger": "distance reaches 100",
            "effect": "Stop progress"
          },
          {
            "from": "playing",
            "to": "lost",
            "trigger": "inside pit without enough jump height",
            "effect": "Stop progress"
          }
        ]
      }
    ],
    "resources": [
      {
        "name": "raf",
        "owner": "ui.js",
        "acquire": "mount creates one loop",
        "release": "dispose cancels it",
        "stale_work_policy": "Session identity rejects callbacks after disposal"
      }
    ],
    "invariants": [
      {
        "id": "fixed-step-pause",
        "statement": "Paused and terminal states cannot advance distance",
        "owners": [
          "engine.js",
          "ui.js"
        ],
        "check_strategy": "Pause midrun and advance; compare captured distance"
      }
    ],
    "state_domains": [
      {
        "id": "match-state",
        "owner": "engine.js",
        "field_ids": [
          "phase",
          "distance",
          "y",
          "time"
        ],
        "lifetime": "attempt",
        "reset_policy": "The existing public reset starts the declared new seeded match",
        "preserve_policy": "Pause and readonly snapshots retain current match values"
      }
    ],
    "transactions": [],
    "progression": [],
    "persistence": [],
    "first_playable_loop": {
      "description": "Jump over an actual obstacle and reach the finish by fixed steps",
      "scenario_id": "jump-to-win"
    }
  },
  "qa_scenarios": [
    {
      "id": "jump-to-win",
      "purpose": "jump-to-win",
      "category": "progress",
      "seed": "fixture",
      "steps": [
        "{\"op\": \"act\", \"action\": {\"type\": \"start\"}}",
        "{\"op\": \"advance\", \"frames\": 40}",
        "{\"op\": \"act\", \"action\": {\"type\": \"jump\"}}",
        "{\"op\": \"advance\", \"frames\": 60}",
        "{\"op\": \"assert\", \"left\": {\"path\": \"/phase\"}, \"cmp\": \"eq\", \"right\": {\"value\": \"won\"}}",
        "{\"op\": \"assert\", \"left\": {\"path\": \"/distance\"}, \"cmp\": \"eq\", \"right\": {\"value\": 100}}"
      ],
      "affected_files": [
        "engine.js",
        "ui.js"
      ],
      "limitations": [
        "Recorded trusted fixture; engine adapter is not browser interaction or a live model evaluation"
      ]
    },
    {
      "id": "no-jump-loses",
      "purpose": "no-jump-loses",
      "category": "strategy",
      "seed": "fixture",
      "steps": [
        "{\"op\": \"act\", \"action\": {\"type\": \"start\"}}",
        "{\"op\": \"advance\", \"frames\": 60}",
        "{\"op\": \"assert\", \"left\": {\"path\": \"/phase\"}, \"cmp\": \"eq\", \"right\": {\"value\": \"lost\"}}",
        "{\"op\": \"assert\", \"left\": {\"path\": \"/distance\"}, \"cmp\": \"eq\", \"right\": {\"value\": 50}}"
      ],
      "affected_files": [
        "engine.js",
        "ui.js"
      ],
      "limitations": [
        "Recorded trusted fixture; engine adapter is not browser interaction or a live model evaluation"
      ]
    },
    {
      "id": "pause-reset",
      "purpose": "pause-reset",
      "category": "lifecycle",
      "seed": "fixture",
      "steps": [
        "{\"op\": \"act\", \"action\": {\"type\": \"start\"}}",
        "{\"op\": \"advance\", \"frames\": 20}",
        "{\"op\": \"act\", \"action\": {\"type\": \"pause\", \"value\": true}}",
        "{\"op\": \"advance\", \"frames\": 40}",
        "{\"op\": \"assert\", \"left\": {\"path\": \"/distance\"}, \"cmp\": \"eq\", \"right\": {\"value\": 20}}",
        "{\"op\": \"reset\"}",
        "{\"op\": \"assert\", \"left\": {\"path\": \"/distance\"}, \"cmp\": \"eq\", \"right\": {\"value\": 0}}",
        "{\"op\": \"assert\", \"left\": {\"path\": \"/phase\"}, \"cmp\": \"eq\", \"right\": {\"value\": \"menu\"}}"
      ],
      "affected_files": [
        "engine.js",
        "ui.js"
      ],
      "limitations": [
        "Recorded trusted fixture; engine adapter is not browser interaction or a live model evaluation"
      ]
    }
  ]
}
