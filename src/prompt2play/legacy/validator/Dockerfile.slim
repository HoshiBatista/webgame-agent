# Explicit development alternative when the official Playwright layer is unavailable.
# The runtime records the resulting immutable image ID and actual browser version.
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends nodejs npm chromium ca-certificates \
    && rm -rf /var/lib/apt/lists/* && useradd --uid 10001 --create-home forgecheck
WORKDIR /validator
RUN npm init -y && npm install --save-exact playwright@1.58.2 esbuild@0.25.12 && npm cache clean --force
COPY *.mjs /validator/
USER 10001:10001
ENV HOME=/tmp CHROMIUM_EXECUTABLE=/usr/bin/chromium
CMD ["node", "/validator/release_runtime.mjs"]
