    "steps": [
      {"action": "press", "key": "Enter"},
      {"action": "press", "key": "ArrowRight"},
      {"action": "press", "key": "ArrowUp"},
      {"action": "checkpoint"},
      {"action": "press", "key": "ArrowUp"},
      {"action": "wait", "ms": 220},
      {"action": "assert", "ms": 0, "observation": {"source": "attribute", "selector": "#board", "attribute": "data-player"}, "expect": {"operator": "eq", "value": "2,2"}},
      {"action": "assert", "ms": 0, "observation": {"source": "text_number", "selector": "#moves"}, "expect": {"operator": "eq", "value": 2}}
    ],
    "observation": {"source": "attribute", "selector": "#board", "attribute": "data-box"},
    "expect": {"operator": "eq", "value": "2,1"}
  },
  {
    "id": "S8",
    "category": "outcome",
    "requirement": "Задача решается настоящими ходами и доставкой ящика на цель",
    "viewport": "mobile",
    "steps": [
      {"action": "tap", "selector": "#start", "x": null, "y": null},
      {"action": "tap", "selector": "#right", "x": null, "y": null},
      {"action": "tap", "selector": "#up", "x": null, "y": null},
      {"action": "tap", "selector": "#left", "x": null, "y": null},
      {"action": "tap", "selector": "#up", "x": null, "y": null},
      {"action": "checkpoint"},
      {"action": "tap", "selector": "#right", "x": null, "y": null},
      {"action": "wait", "ms": 250},
      {"action": "assert", "ms": 0, "observation": {"source": "attribute", "selector": "#board", "attribute": "data-box"}, "expect": {"operator": "eq", "value": "3,1"}},
      {"action": "assert", "ms": 0, "observation": {"source": "text_number", "selector": "#moves"}, "expect": {"operator": "eq", "value": 5}}
    ],
    "observation": {"source": "text", "selector": "#status"},
    "expect": {"operator": "contains", "value": "Победа"}
  },
  {
    "id": "S9",
    "category": "regression",
    "requirement": "После победы игровой результат сохраняется",
    "viewport": "desktop",
    "steps": [
      {"action": "press", "key": "Enter"},
      {"action": "press", "key": "ArrowRight"},
      {"action": "press", "key": "ArrowUp"},
      {"action": "press", "key": "ArrowLeft"},
      {"action": "press", "key": "ArrowUp"},
      {"action": "press", "key": "ArrowRight"},
      {"action": "checkpoint"},
      {"action": "press", "key": "ArrowLeft"},
      {"action": "press", "key": "ArrowDown"},
      {"action": "wait", "ms": 250},
      {"action": "assert", "ms": 0, "observation": {"source": "attribute", "selector": "#board", "attribute": "data-player"}, "expect": {"operator": "eq", "value": "2,1"}},
      {"action": "assert", "ms": 0, "observation": {"source": "attribute", "selector": "#board", "attribute": "data-box"}, "expect": {"operator": "eq", "value": "3,1"}}
    ],
    "observation": {"source": "text_number", "selector": "#moves"},
    "expect": {"operator": "eq", "value": 5}
  },
  {
    "id": "S10",
    "category": "restart",
    "requirement": "Перезапуск после победы восстанавливает исходное поле и счётчик",
    "viewport": "mobile",
    "steps": [
      {"action": "tap", "selector": "#start", "x": null, "y": null},
      {"action": "tap", "selector": "#right", "x": null, "y": null},
      {"action": "tap", "selector": "#up", "x": null, "y": null},
      {"action": "tap", "selector": "#left", "x": null, "y": null},
      {"action": "tap", "selector": "#up", "x": null, "y": null},
      {"action": "tap", "selector": "#right", "x": null, "y": null},
      {"action": "assert", "ms": 0, "observation": {"source": "attribute", "selector": "#board", "attribute": "data-box"}, "expect": {"operator": "eq", "value": "3,1"}},
      {"action": "checkpoint"},
      {"action": "tap", "selector": "#replay", "x": null, "y": null},
      {"action": "assert", "ms": 0, "observation": {"source": "attribute", "selector": "#board", "attribute": "data-player"}, "expect": {"operator": "eq", "value": "1,3"}},
      {"action": "assert", "ms": 0, "observation": {"source": "attribute", "selector": "#board", "attribute": "data-box"}, "expect": {"operator": "eq", "value": "2,2"}},
      {"action": "assert", "ms": 0, "observation": {"source": "text_number", "selector": "#moves"}, "expect": {"operator": "eq", "value": 0}},
      {"action": "tap", "selector": "#up", "x": null, "y": null},
      {"action": "wait", "ms": 220}
    ],
    "observation": {"source": "attribute", "selector": "#board", "attribute": "data-player"},
    "expect": {"operator": "eq", "value": "1,2"}
  },
  {
    "id": "S11",
    "category": "regression",
    "requirement": "Поворот телефона сохраняет позиции и счётчик",
    "viewport": "mobile",
    "steps": [
      {"action": "tap", "selector": "#start", "x": null, "y": null},
      {"action": "tap", "selector": "#right", "x": null, "y": null},
      {"action": "tap", "selector": "#up", "x": null, "y": null},
      {"action": "resize", "viewport": "landscape"},
      {"action": "wait", "ms": 220},
      {"action": "assert", "ms": 0, "observation": {"source": "attribute", "selector": "#board", "attribute": "data-player"}, "expect": {"operator": "eq", "value": "2,2"}},
      {"action": "assert", "ms": 0, "observation": {"source": "text_number", "selector": "#moves"}, "expect": {"operator": "eq", "value": 2}}
    ],
    "observation": {"source": "attribute", "selector": "#board", "attribute": "data-box"},
    "expect": {"operator": "eq", "value": "2,1"}
  },
  {
    "id": "S12",
    "category": "regression",
    "requirement": "Музыка запускается после действия игрока",
    "viewport": "mobile",
    "steps": [
      {"action": "tap", "selector": "#start", "x": null, "y": null},
      {"action": "wait", "ms": 200}
    ],
    "observation": {"source": "experience", "field": "musicPlaying"},
    "expect": {"operator": "eq", "value": true}
  }
]
