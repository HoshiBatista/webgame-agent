[
  {
    "id": "S1",
    "category": "start",
    "requirement": "Понятный старт с исходными позициями и нулём ходов",
    "viewport": "mobile",
    "steps": [
      {"action": "tap", "selector": "#start", "x": null, "y": null},
      {"action": "wait", "ms": 220},
      {"action": "assert", "ms": 0, "observation": {"source": "attribute", "selector": "#board", "attribute": "data-player"}, "expect": {"operator": "eq", "value": "1,3"}},
      {"action": "assert", "ms": 0, "observation": {"source": "text_number", "selector": "#moves"}, "expect": {"operator": "eq", "value": 0}}
    ],
    "observation": {"source": "attribute", "selector": "#board", "attribute": "data-box"},
    "expect": {"operator": "eq", "value": "2,2"}
  },
  {
    "id": "S2",
    "category": "control",
    "requirement": "Экранная кнопка действительно передвигает игрока",
    "viewport": "mobile",
    "steps": [
      {"action": "tap", "selector": "#start", "x": null, "y": null},
      {"action": "checkpoint"},
      {"action": "tap", "selector": "#up", "x": null, "y": null},
      {"action": "wait", "ms": 220}
    ],
    "observation": {"source": "attribute", "selector": "#board", "attribute": "data-player"},
    "expect": {"operator": "eq", "value": "1,2"}
  },
  {
    "id": "S3",
    "category": "control",
    "requirement": "Стрелки клавиатуры передвигают игрока без мыши",
    "viewport": "desktop",
    "steps": [
      {"action": "press", "key": "Enter"},
      {"action": "checkpoint"},
      {"action": "press", "key": "ArrowUp"},
      {"action": "wait", "ms": 220}
    ],
    "observation": {"source": "attribute", "selector": "#board", "attribute": "data-player"},
    "expect": {"operator": "eq", "value": "1,2"}
  },
  {
    "id": "S4",
    "category": "regression",
    "requirement": "Стена не пропускает игрока и не добавляет успешный ход",
    "viewport": "mobile",
    "steps": [
      {"action": "tap", "selector": "#start", "x": null, "y": null},
      {"action": "tap", "selector": "#left", "x": null, "y": null},
      {"action": "tap", "selector": "#down", "x": null, "y": null},
      {"action": "assert", "ms": 0, "observation": {"source": "attribute", "selector": "#board", "attribute": "data-player"}, "expect": {"operator": "eq", "value": "1,3"}},
      {"action": "assert", "ms": 0, "observation": {"source": "attribute", "selector": "#board", "attribute": "data-box"}, "expect": {"operator": "eq", "value": "2,2"}}
    ],
    "observation": {"source": "text_number", "selector": "#moves"},
    "expect": {"operator": "eq", "value": 0}
  },
  {
    "id": "S5",
    "category": "control",
    "requirement": "Допустимый толчок передвигает игрока и ящик",
    "viewport": "mobile",
    "steps": [
      {"action": "tap", "selector": "#start", "x": null, "y": null},
      {"action": "tap", "selector": "#right", "x": null, "y": null},
      {"action": "checkpoint"},
      {"action": "tap", "selector": "#up", "x": null, "y": null},
      {"action": "wait", "ms": 220},
      {"action": "assert", "ms": 0, "observation": {"source": "attribute", "selector": "#board", "attribute": "data-player"}, "expect": {"operator": "eq", "value": "2,2"}},
      {"action": "assert", "ms": 0, "observation": {"source": "text_number", "selector": "#moves"}, "expect": {"operator": "eq", "value": 2}}
    ],
    "observation": {"source": "attribute", "selector": "#board", "attribute": "data-box"},
    "expect": {"operator": "eq", "value": "2,1"}
  },
  {
    "id": "S6",
    "category": "regression",
    "requirement": "Удаление от ящика не тянет его за игроком",
    "viewport": "mobile",
    "steps": [
      {"action": "tap", "selector": "#start", "x": null, "y": null},
      {"action": "tap", "selector": "#right", "x": null, "y": null},
      {"action": "tap", "selector": "#up", "x": null, "y": null},
      {"action": "checkpoint"},
      {"action": "tap", "selector": "#down", "x": null, "y": null},
      {"action": "wait", "ms": 220},
      {"action": "assert", "ms": 0, "observation": {"source": "attribute", "selector": "#board", "attribute": "data-player"}, "expect": {"operator": "eq", "value": "2,3"}}
    ],
    "observation": {"source": "attribute", "selector": "#board", "attribute": "data-box"},
    "expect": {"operator": "eq", "value": "2,1"}
  },
  {
    "id": "S7",
    "category": "regression",
    "requirement": "Толчок ящика в стену запрещён",
