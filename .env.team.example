# Copy to .env for Docker Compose. This file contains NO working credentials.
# Replace the four CHANGE_ME values before starting. Keep .env private.
DJANGO_SECRET_KEY=CHANGE_ME_RANDOM_SECRET
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME_UNIQUE_PASSWORD
# Use hex characters only: this value is embedded in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_HEX_PASSWORD

CONTAINER_PROVIDER=relay
CONTAINER_MODEL=qwen38
GAMEFORGE_RELAY_URL=https://212.57.126.215
GAMEFORGE_RELAY_API_KEY=CHANGE_ME_PERSONAL_RELAY_CLIENT_TOKEN
GAMEFORGE_VLLM_JSON_MODE=json_schema
GAMEFORGE_VLLM_CONTEXT_CHECK=server
GAMEFORGE_MAX_REPAIR_ATTEMPTS=3
GAMEFORGE_BUDGET_USD=50
GAMEFORGE_PRICES_JSON={"qwen38":{"input":0,"cached":0,"output":0,"context_window":32768,"max_output_tokens":16384}}
