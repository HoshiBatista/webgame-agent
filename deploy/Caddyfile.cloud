noxlight7.fvds.ru {
    handle /bridge/v1/* {
        header X-Relay-Node relay-212-57-126-215
        request_body {
            max_size 5MB
        }
        reverse_proxy 127.0.0.1:8100 {
            transport http {
                dial_timeout 5s
                response_header_timeout 30s
            }
        }
    }
    handle {
        redir https://212.57.126.215{uri} 302
    }
}

https://noxlight7.fvds.ru:8443 {
    handle /preview/* {
        reverse_proxy 127.0.0.1:8081 {
            header_up -Cookie
            header_up -Authorization
            header_down -Set-Cookie
        }
    }
    handle {
        respond 404
    }
}

https://212.57.126.215 {
    tls {
        issuer acme {
            profile shortlived
        }
    }
    handle /bridge/v1/* {
        header X-Relay-Node relay-212-57-126-215
        request_body {
            max_size 5MB
        }
        reverse_proxy 127.0.0.1:8100
    }
    handle {
        reverse_proxy 127.0.0.1:8080
    }
}

https://212.57.126.215:8443 {
    tls {
        issuer acme {
            profile shortlived
        }
    }
    handle /preview/* {
        reverse_proxy 127.0.0.1:8081 {
            header_up -Cookie
            header_up -Authorization
            header_down -Set-Cookie
        }
    }
    handle {
        respond 404
    }
}
