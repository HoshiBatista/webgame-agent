http://beegame.ru, http://preview.beegame.ru, http://lite.beegame.ru {
    handle /.well-known/acme-challenge/* {
        root * /var/lib/caddy/certbot-webroot
        file_server
    }
    handle {
        redir https://{host}{uri} 308
    }
}

beegame.ru {
    tls /etc/caddy/certbot/beegame.ru/current/fullchain.pem /etc/caddy/certbot/beegame.ru/current/privkey.pem
    reverse_proxy 127.0.0.1:8080
}

preview.beegame.ru {
    tls /etc/caddy/certbot/beegame.ru/current/fullchain.pem /etc/caddy/certbot/beegame.ru/current/privkey.pem
    handle /preview/* {
        reverse_proxy 127.0.0.1:8081 {
            header_up -Cookie
            header_up -Authorization
            header_down -Set-Cookie
        }
    }
    handle {
        respond 404
    }
}

lite.beegame.ru {
    tls /etc/caddy/certbot/beegame.ru/current/fullchain.pem /etc/caddy/certbot/beegame.ru/current/privkey.pem
    handle /bridge/v1/* {
        request_body {
            max_size 5MB
        }
        reverse_proxy 127.0.0.1:8100
    }
    handle {
        respond 404
    }
}

noxlight7.fvds.ru {
    handle /bridge/v1/* {
        header X-Relay-Node relay-212-57-126-215
        request_body {
            max_size 5MB
        }
        reverse_proxy 127.0.0.1:8100 {
            transport http {
                dial_timeout 5s
                response_header_timeout 30s
            }
        }
    }
    handle {
        redir https://beegame.ru{uri} 302
    }
}

https://noxlight7.fvds.ru:8443 {
    handle /preview/* {
        redir https://preview.beegame.ru{uri} 302
    }
    handle {
        respond 404
    }
}

https://212.57.126.215 {
    tls {
        issuer acme {
            profile shortlived
        }
    }
    handle /bridge/v1/* {
        header X-Relay-Node relay-212-57-126-215
        request_body {
            max_size 5MB
        }
        reverse_proxy 127.0.0.1:8100
    }
    handle {
        redir https://beegame.ru{uri} 302
    }
}

https://212.57.126.215:8443 {
    tls {
        issuer acme {
            profile shortlived
        }
    }
    handle /preview/* {
        redir https://preview.beegame.ru{uri} 302
    }
    handle {
        respond 404
    }
}
