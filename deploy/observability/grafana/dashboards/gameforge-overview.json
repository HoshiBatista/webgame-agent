    {
      "title": "Run outcomes / 5m (best effort)",
      "type": "timeseries",
      "description": "succeeded is automatic acceptance. unverified/needs_attention remain separate. Fake provider is labelled.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status,provider,profile) (increase(gameforge_runs_finished_total[5m]))",
          "legendFormat": "{{status}} {{provider}} {{profile}} {{component}} {{dependency}}",
          "range": true,
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
