{
  "uid": "gameforge-overview",
  "title": "GameForge · Overview",
  "tags": [
    "gameforge"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "editable": false,
  "description": "Operational health; durable ledger and best effort counters have different semantics. No game quality or real model performance claim.",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "title": "Dependencies",
      "type": "stat",
      "description": "1=healthy. Validator is a model-free isolation probe, not a game test.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (dependency) (gameforge_dependency_up)",
          "legendFormat": "{{status}} {{provider}} {{profile}} {{component}} {{dependency}}",
          "range": true,
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "id": 1
    },
    {
      "title": "Last state snapshot age",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(gameforge_state_snapshot_timestamp_seconds)",
          "legendFormat": "{{status}} {{provider}} {{profile}} {{component}} {{dependency}}",
          "range": true,
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "id": 2
    },
    {
      "title": "Run states (durable ledger)",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (max by(status,provider,profile,operation)(gameforge_runs))",
          "legendFormat": "{{status}} {{provider}} {{profile}} {{component}} {{dependency}}",
          "range": true,
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
