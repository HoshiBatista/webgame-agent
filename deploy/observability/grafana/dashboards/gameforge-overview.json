        }
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "id": 8
    },
    {
      "title": "Run wall time p95",
      "type": "timeseries",
      "description": "Completed runs observed since telemetry enabled, including queue time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, provider, profile) (rate(gameforge_run_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{status}} {{provider}} {{profile}} {{component}} {{dependency}}",
          "range": true,
          "exemplar": true
        }
