{
  "uid": "gameforge-generation",
  "title": "GameForge · Generation & queue",
  "tags": [
    "gameforge"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "15s",
  "editable": false,
  "description": "No extra provider calls. Game acceptance is determined by the existing artifact/check policy, not by telemetry or Celery task completion.",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "title": "Run outcomes",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status,provider,profile) (increase(gameforge_runs_finished_total[$__range]))",
          "legendFormat": "{{status}} {{provider}} {{profile}} {{component}} {{dependency}}",
          "range": true,
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "id": 1
    },
    {
      "title": "Provider transport p95",
      "type": "timeseries",
      "description": "Includes transport, polling and normalization. Each poll is not a new model inference.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, provider, operation, outcome) (rate(gameforge_operation_seconds_bucket{component=\"provider_transport\"}[$__rate_interval])))",
          "legendFormat": "{{status}} {{provider}} {{profile}} {{component}} {{dependency}}",
          "range": true,
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "id": 2
    },
    {
      "title": "Operations / second",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (component,outcome)(rate(gameforge_operations_total[$__rate_interval]))",
          "legendFormat": "{{status}} {{provider}} {{profile}} {{component}} {{dependency}}",
          "range": true,
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "id": 3
    },
    {
      "title": "Game model sends (best effort)",
      "type": "timeseries",
      "description": "First durable sent marker only. Receipt polling is excluded. Feedback calls are separate durable jobs.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider,profile)(increase(gameforge_invocations_sent_total[$__range]))",
          "legendFormat": "{{status}} {{provider}} {{profile}} {{component}} {{dependency}}",
