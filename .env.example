# Select "vllm" for the corporate connector or "openai" for the hosted fallback.
P2P_MODEL_PROVIDER=vllm
P2P_MODEL_MAX_OUTPUT_TOKENS=64000
P2P_VLLM_BASE_URL=http://vllm-server:8000/v1
P2P_VLLM_MODEL=prompt2play-code
P2P_VLLM_API_KEY=
P2P_VLLM_TIMEOUT_SECONDS=180

# Optional hosted fallback; used only when P2P_MODEL_PROVIDER=openai.
OPENAI_API_KEY=
P2P_OPENAI_MODEL=
P2P_OPENAI_REASONING_EFFORT=medium
P2P_OPENAI_TIMEOUT_SECONDS=120
P2P_POSTGRES_PASSWORD=prompt2play
P2P_DATABASE_URL=postgresql+psycopg://prompt2play:prompt2play@postgres:5432/prompt2play
P2P_REDIS_URL=redis://redis:6379/0
P2P_ARTIFACT_ROOT=/data/artifacts
P2P_VALIDATION_ROOT=/data/validation
P2P_PUBLIC_BASE_URL=http://localhost:5173
P2P_CORS_ORIGINS=http://localhost:5173
P2P_ADMIN_USERNAME=admin
P2P_ADMIN_PASSWORD=
P2P_SESSION_TTL_HOURS=24
P2P_STAGE_LEASE_SECONDS=600
P2P_BROWSER_VALIDATION=true
P2P_WEB_PORT=5173
