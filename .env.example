DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=replace-with-a-unique-long-password
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=postgresql:///gameforge_mini
REDIS_URL=redis://127.0.0.1:56379/0
GAMEFORGE_PROVIDER=codex
GAMEFORGE_MODEL=gpt-6-luna
GAMEFORGE_BUDGET_USD=50
GAMEFORGE_PROVIDER_CONCURRENCY=1
GAMEFORGE_APP_ORIGIN=http://127.0.0.1:8000
GAMEFORGE_PREVIEW_ORIGIN=http://localhost:8001
# For the future API deployment; credentials stay in the model worker only.
GAMEFORGE_VLLM_URL=http://model-server:8000/v1
GAMEFORGE_VLLM_MODEL=your-model
GAMEFORGE_VLLM_API_KEY=
GAMEFORGE_VLLM_JSON_MODE=json_object
GAMEFORGE_VLLM_STREAM=true
# Trusted server-side tariff and bounds for a future local model (not an API invoice):
# GAMEFORGE_PRICES_JSON={"your-model":{"input":0,"cached":0,"output":0,"context_window":32000,"max_output_tokens":12000}}
