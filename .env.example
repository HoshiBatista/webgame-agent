DJANGO_SECRET_KEY=replace-with-a-random-secret
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=replace-with-a-unique-long-password
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=postgresql:///gameforge_mini
REDIS_URL=redis://127.0.0.1:56379/0
GAMEFORGE_PROVIDER=codex
GAMEFORGE_MODEL=gpt-6-sol
GAMEFORGE_PRO_ENABLED=1
GAMEFORGE_LOCAL_ONLY=1
# Optional Lite provider/model when the default is Codex:
GAMEFORGE_LITE_PROVIDER=
GAMEFORGE_LITE_MODEL=
GAMEFORGE_BUDGET_USD=50
GAMEFORGE_PROVIDER_CONCURRENCY=1
# One initial call plus 2 or 3 focused repairs, saved per run (all providers).
GAMEFORGE_MAX_REPAIR_ATTEMPTS=3
GAMEFORGE_APP_ORIGIN=http://127.0.0.1:8000
GAMEFORGE_PREVIEW_ORIGIN=http://localhost:8001
# Select GAMEFORGE_PROVIDER=vllm and leave GAMEFORGE_MODEL empty to use LLM_MODEL.
# Pro defaults to local staff only. Cloud opt-in: docs/cloud-deployment.ru.md.
# Only the worker receives the proxy token in Compose; never put it in VITE_*.
LLM_BASE_URL=https://your-proxy/v1
LLM_MODEL=qwen38
LLM_API_KEY=
# Optional overrides; nonempty GAMEFORGE_VLLM_* values take precedence over LLM_*.
GAMEFORGE_VLLM_URL=
GAMEFORGE_VLLM_MODEL=
GAMEFORGE_VLLM_API_KEY=
# Prefer schema-constrained output on vLLM; json_object only guarantees valid JSON.
GAMEFORGE_VLLM_JSON_MODE=json_schema
# server: only for a verified backend that enforces context with its own tokenizer.
# Applies to vllm and relay; input is never truncated. Conservative is the portable default.
GAMEFORGE_VLLM_CONTEXT_CHECK=conservative
GAMEFORGE_VLLM_STREAM=true
GAMEFORGE_VLLM_CONNECT_TIMEOUT=15
GAMEFORGE_VLLM_READ_TIMEOUT=660
# Optional private rotating JSONL log. Parent directory must exist and be writable.
# Without this, transport diagnostics go to worker stderr (also in Docker).
# GAMEFORGE_TRANSPORT_LOG=/absolute/path/to/.data/llm-transport.jsonl
# Durable queue: choose GAMEFORGE_PROVIDER=relay only after relay + GPU executor are installed.
# This is a NEW role=client queue token, independent of LLM_API_KEY and the upstream vLLM key.
GAMEFORGE_RELAY_URL=https://your-proxy
GAMEFORGE_RELAY_API_KEY=
# Optional secret file instead of the value (local/systemd installations):
# GAMEFORGE_RELAY_API_KEY_FILE=/private/path/client-token
# Trusted server-side tariff and bounds for a future local model (not an API invoice):
# GAMEFORGE_PRICES_JSON={"your-model":{"input":0,"cached":0,"output":0,"context_window":32000,"max_output_tokens":12000}}
