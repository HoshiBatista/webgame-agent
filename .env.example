# Required only by worker-models. Prefer a project service-account key scoped to api.responses.write.
OPENAI_API_KEY=

P2P_OPENAI_MODEL=gpt-6-luna
P2P_OPENAI_REASONING_EFFORT=medium
P2P_OPENAI_TIMEOUT_SECONDS=120
P2P_POSTGRES_PASSWORD=prompt2play
P2P_DATABASE_URL=postgresql+psycopg://prompt2play:prompt2play@postgres:5432/prompt2play
P2P_REDIS_URL=redis://redis:6379/0
P2P_ARTIFACT_ROOT=/data/artifacts
P2P_PUBLIC_BASE_URL=http://localhost:5173
P2P_CORS_ORIGINS=http://localhost:5173
P2P_BROWSER_VALIDATION=true
P2P_WEB_PORT=5173
